{
    "name": "amc_process",
    "description": "Preprocessing of AMC data (Snowflake equivalent of etl_amc_hpc_snowflake_equiv)",
    "SOURCE": "SNOWFLAKE",

    "preprocessing": "/tmp/preprocessing_amc",

    "snowflake_config": {
        "input_schema": "DATATOOLS4HEARTSEAN",
        "output_schema": "DATATOOLS4HEARTSEAN",
        "database": "HEALTHCARE_DB"
    },

    "Datatools4heart_Patient": {
        "table_name": "TBL_PATIENT",
        "columns": ["PSEUDO_ID", "GEBOORTEJAAR", "GEBOORTEMAAND", "GESLACHT", "OVERLIJDENSDATUM"]
    },
    "Datatools4heart_Opnametraject": {
        "table_name": "TBL_OPNAMETRAJECT",
        "columns": ["PSEUDO_ID", "OPNAMEDATUM"]
    },
    "Datatools4heart_Tabakgebruik": {
        "table_name": "TBL_TABAKGEBRUIK",
        "columns": ["PSEUDO_ID", "ISHUIDIGEROKER", "ISVOORMALIGROKER", "PATIENTCONTACTID"]
    },
    "Datatools4heart_MetingBMI": {
        "table_name": "TBL_METINGBMI",
        "columns": ["PSEUDO_ID", "PATIENTCONTACTID", "BMI"]
    },
    "Datatools4heart_MetingBloeddrukGemiddelde": {
        "table_name": "TBL_METINGBLOEDDRUKGEMIDDELDE",
        "columns": ["PSEUDO_ID", "PATIENTCONTACTID", "BLOEDDRUKGEMIDDELDE"]
    },
    "Datatools4heart_MetingHartfrequentie": {
        "table_name": "TBL_METINGHARTFREQUENTIE",
        "columns": ["PSEUDO_ID", "PATIENTCONTACTID", "HARTFREQUENTIE"]
    },
    "Datatools4heart_MetingLichaamsGewicht": {
        "table_name": "TBL_METINGLICHAAMSGEWICHT",
        "columns": ["PSEUDO_ID", "PATIENTCONTACTID", "LICHAAMSGEWICHT"]
    },
    "Datatools4heart_Metingo2Saturatie": {
        "table_name": "TBL_METINGO2SATURATIE",
        "columns": ["PSEUDO_ID", "PATIENTCONTACTID", "O2SATURATIE"]
    },
    "Datatools4heart_MetingBloeddruk": {
        "table_name": "TBL_METINGBLOEDDRUK",
        "columns": ["PSEUDO_ID", "PATIENTCONTACTID", "SYSTOLISCHEBLOEDDRUKWAARDE", "DIASTOLISCHEBLOEDDRUKWAARDE"]
    },
    "Datatools4heart_VoorgeschiedenisMedisch": {
        "table_name": "TBL_VOORGESCHIEDENISMEDISCH",
        "columns": ["PSEUDO_ID", "DIAGNOSECODE_CLASSIFIED",
                   {"DIAGNOSECODE": {"t2dm": "T2DM", "af": "AF", "acute_mi": "ACUTE_MI"}},
                   ["INDICATIEDATUMVASTSTELLING"]]
    },
    "Datatools4heart_VoorgeschiedenisFamilie": {
        "table_name": "TBL_VOORGESCHIEDENISFAMILIE",
        "columns": ["PSEUDO_ID", "FAMILIEVOORGESCHIEDENIS", "HF_FAM"]
    },
    "Datatools4heart_MedicatieToediening": {
        "table_name": "TBL_MEDICATIETOEDIENING",
        "columns": ["PSEUDO_ID", "ATCCODE_CLASSIFIED",
                   {"ATCCODE": {"ace": "ACE", "beta": "BETA"}},
                   ["TOEDIENINGSDATUM"]]
    },
    "Datatools4heart_Labuitslag": {
        "table_name": "TBL_LABUITSLAG",
        "columns": ["PSEUDO_ID", "BEPALINGCODE",
                   {"UITSLAGNUMERIEK": {
                       "RKRE;BL": "CREATININE",
                       "CKD-EPI;BL": "EGFR",
                       "P_LACT_HB": "LACTATE",
                       "P_PH_HB": "PH",
                       "P_PCO2P_HB": "PCO2",
                       "P_KA_HB": "KALIUM",
                       "P_NA_HB": "NATRIUM",
                       "P_HB_HB": "HEMOGLOBIN",
                       "GLUCS;BL": "GLUCOSE",
                       "P_CA_HB": "CALCIUM",
                       "P_CL_HB": "CHLORIDE",
                       "P_HCT_HB": "HEMATOCRIT",
                       "P_AHCO3_HB": "BICARBONATE",
                       "P_BE_HB": "BASE_EXCESS",
                       "DTMP;BL": "TEMPERATURE"
                   }},
                   ["MATERIAALAFNAMEDATUM"]]
    },

    "categories": {"GESLACHT": ["Man", "Vrouw"]},

    "final_cols": ["GESLACHT", "AGEATOPNAME", "ISHUIDIGEROKER", "ISVOORMALIGROKER", "OPNAMEDATUM",
        "BMI", "SYSTOLISCHEBLOEDDRUKWAARDE", "DIASTOLISCHEBLOEDDRUKWAARDE", "BLOEDDRUKGEMIDDELDE", "HARTFREQUENTIE",
        "LICHAAMSGEWICHT", "O2SATURATIE", "ACE", "TIME", "BETA", "CREATININE", "T2DM", "ACUTE_MI", "AF", "HF_FAM",
        "EGFR", "NATRIUM", "KALIUM", "HEMOGLOBIN", "LACTATE", "BICARBONATE", "CHLORIDE", "PCO2", "PH", "GLUCOSE",
        "CALCIUM", "HEMATOCRIT", "BASE_EXCESS", "TEMPERATURE"],

    "tuple_vals_after": ["CREATININE",
        "EGFR", "NATRIUM", "KALIUM", "HEMOGLOBIN", "LACTATE", "BICARBONATE", "CHLORIDE", "PCO2", "PH",
        "GLUCOSE", "CALCIUM", "HEMATOCRIT", "BASE_EXCESS", "TEMPERATURE"],
    "tuple_vals_anybefore": ["ACE", "BETA", "T2DM", "ACUTE_MI", "AF"],

    "ref_date": "OPNAMEDATUM",
    "enable_fallback": true,

    "InitTransforms": {
        "ATCCODE_CLASSIFIED": {
            "func": "classify",
            "kwargs": {
                "classification_map": ["ace", "beta"],
                "input_col": "ATCCODE",
                "out_col": "ATCCODE_CLASSIFIED",
                "id_col": "PSEUDO_ID"
            }
        },
        "DIAGNOSECODE_CLASSIFIED": {
            "func": "classify",
            "kwargs": {
                "classification_map": ["t2dm", "af", "acute_mi"],
                "input_col": "DIAGNOSECODE",
                "out_col": "DIAGNOSECODE_CLASSIFIED",
                "id_col": "PSEUDO_ID"
            }
        },
        "FAMILIEVOORGESCHIEDENIS": {
            "func": "pattern_match",
            "kwargs": {
                "id_col": "PSEUDO_ID",
                "search_col": "FAMILIEVOORGESCHIEDENIS",
                "pattern_dict": {
                    "HF_FAM": "hart|plots"
                },
                "case_sensitive": false,
                "group_by_id": true
            }
        }
    },
    "PreTransforms": {
        "OPNAMEDATUM": {
            "func": "datetime_keepfirst",
            "kwargs": {
                "col_to_date": "OPNAMEDATUM",
                "sort_col": "OPNAMEDATUM",
                "drop_col": "PSEUDO_ID"
            }
        },
        "OVERLIJDENSDATUM": {
            "func": "datetime",
            "kwargs": {
                "col_to_date": "OVERLIJDENSDATUM"
            }
        },
        "ISHUIDIGEROKER": {
            "func": "keepfirst",
            "kwargs": {
                "sort_col": "PATIENTCONTACTID",
                "drop_col": "PSEUDO_ID"
            }
        },
        "SYSTOLISCHEBLOEDDRUKWAARDE": {
            "func": "keepfirst",
            "kwargs": {
                "sort_col": "PATIENTCONTACTID",
                "drop_col": "PSEUDO_ID"
            }
        },
        "BMI": {
            "func": "keepfirst",
            "kwargs": {
                "sort_col": "PATIENTCONTACTID",
                "drop_col": "PSEUDO_ID"
            }
        },
        "BLOEDDRUKGEMIDDELDE": {
            "func": "keepfirst",
            "kwargs": {
                "sort_col": "PATIENTCONTACTID",
                "drop_col": "PSEUDO_ID"
            }
        },
        "HARTFREQUENTIE": {
            "func": "keepfirst",
            "kwargs": {
                "sort_col": "PATIENTCONTACTID",
                "drop_col": "PSEUDO_ID"
            }
        },
        "LICHAAMSGEWICHT": {
            "func": "keepfirst",
            "kwargs": {
                "sort_col": "PATIENTCONTACTID",
                "drop_col": "PSEUDO_ID"
            }
        },
        "O2SATURATIE": {
            "func": "keepfirst",
            "kwargs": {
                "sort_col": "PATIENTCONTACTID",
                "drop_col": "PSEUDO_ID"
            }
        }
    },
    "MergedTransforms": {
        "TIME": {
            "func": "diff",
            "kwargs": {
                "end": "OVERLIJDENSDATUM",
                "start": "OPNAMEDATUM"
            }
        },
        "AGEATOPNAME": {
            "func": "diff",
            "kwargs": {
                "end": "OPNAMEDATUM",
                "start": "GEBOORTEJAAR",
                "level": "year"
            }
        },
        "GESLACHT": {
            "func": "map",
            "kwargs": {
                "map": {"Man": 0, "Vrouw": 1}
            }
        },
        "ISHUIDIGEROKER": {
            "func": "map",
            "kwargs": {
                "map": {"Nee": 0, "Ja": 1}
            }
        },
        "ISVOORMALIGROKER": {
            "func": "map",
            "kwargs": {
                "map": {"Nee": 0, "Ja": 1}
            }
        }
    }
}
